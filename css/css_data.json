{
    "persona": {
        "label": "Mining Heritage",
        "tone": "Historical, robust, cultural",
        "visual_intensity": "medium",
        "risk_tolerance": "conservative"
    },
    "tokens": {
        "colors": {
            "primary": "#b7791f",
            "secondary": "#975a16",
            "accent": "#d69e2e",
            "bg": "#fffff0",
            "text": "#744210",
            "hover": "#744210",
            "active": "#5a340c",
            "focus": "#b7791f",
            "success": "#48bb78",
            "error": "#f56565",
            "warning": "#faf089",
            "info": "#4299e1",
            "neutral": "#fefcbf",
            "link": "#975a16",
            "border": "#ecc94b",
            "surface": "#fefcbf",
            "gradient_bg": "linear-gradient(to top left, #fffff0, #fefcbf)"
        },
        "typography": {
            "primary_font": "'EB Garamond', system-ui, sans-serif",
            "base_size": "17px",
            "line_height": "1.55",
            "heading_sizes": [
                "2.9rem",
                "2.4rem",
                "2.0rem",
                "1.7rem",
                "1.4rem",
                "1.2rem"
            ]
        },
        "spacing": {
            "xs": "4px",
            "s": "8px",
            "m": "16px",
            "l": "28px",
            "xl": "44px",
            "xxl": "64px"
        },
        "borders": {
            "radius": "5px"
        },
        "shadows": {
            "low": "0 3px 6px rgba(183,121,31,0.05)",
            "medium": "0 8px 16px rgba(183,121,31,0.1)"
        },
        "motion": {
            "timing": "0.4s ease-in-out"
        },
        "breakpoints": {
            "tablet": "768px",
            "desktop": "1024px"
        },
        "animations": {
            "duration_base": 0.4,
            "ease_default": "easeInOutCirc",
            "intensity_mod": 1.0,
            "risk_ease": "ease-in-out",
            "mobile_mod": 0.7
        }
    },
    "page_customizations": {
        "home": {
            "hero_bg": "var(--color-surface)",
            "cta_color": "var(--color-accent)",
            "section_border": "var(--color-border)"
        },
        "about": {
            "intro_text": "var(--color-text)",
            "section_border": "var(--color-border)",
            "hero_bg": "var(--color-neutral)"
        },
        "services": {
            "overview_bg": "var(--color-surface)",
            "item_accent": "var(--color-accent)",
            "list_color": "var(--color-info)"
        },
        "contact": {
            "form_bg": "var(--color-surface)",
            "submit_btn": "var(--color-primary)",
            "input_border": "var(--color-border)"
        }
    }
}